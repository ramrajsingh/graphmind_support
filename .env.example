# Copy to .env and fill in the values.

# --- FalkorDB: agent memory graph ---
# Local Docker: docker run -p 6379:6379 falkordb/falkordb  (leave username/password empty)
# FalkorDB Cloud: copy host, port, username and password from app.falkordb.cloud
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_GRAPH=support_memory

# --- Sarvam AI: speech and translation (https://dashboard.sarvam.ai) ---
SARVAM_API_KEY=

# --- LLM that runs the agent: openai or anthropic ---
LLM_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
